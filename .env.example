# === Downdetector Live ===
# Chave de API do app Speedtest (extraída do IPA/APK — ver README).
# iOS: SpeedTestUserApiKey do Info.plist · Android: const-string de 30 chars no dex.
DD_API_KEY=

# País monitorado (BR, US, GB, DE, FR, IT, ES, PT, MX, AR, CA, AU, IN, ...)
DD_ISO=BR

# Serviços a vigiar (slugs separados por vírgula). Vazio = todos do país.
DD_WATCH=nubank,govbr,claro,vivo,tim,pix,whatsapp,instagram

# Cache/intervalo em segundos
DD_TTL=120
DD_INTERVAL=120

# === Alertas (Google Chat e/ou Slack) ===
# Webhook(s) do Google Chat (Espaço → Apps e integrações → Webhooks)
DD_WEBHOOK=
# Webhook(s) do Slack (App → Incoming Webhooks)
DD_SLACK=
# Pelo menos um de DD_WEBHOOK ou DD_SLACK é obrigatório para o notifier.
# Vários webhooks separados por vírgula.

# Trigger do alerta: 'danger' (só outage) ou 'warning' (inclui instável)
DD_TRIGGER=danger
# Opcional: alerta também quando reports/baseline >= RATIO (0 = desligado)
DD_RATIO=0

# === Grafana ===
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
